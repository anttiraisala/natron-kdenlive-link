# Removes every file recorded in install_manifest.txt by "make install".
if(NOT EXISTS "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
  message(FATAL_ERROR "install_manifest.txt not found: nothing to uninstall (was 'install' run from this build directory?)")
endif()
file(READ "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt" files)
string(REGEX REPLACE "\n" ";" files "${files}")
foreach(file ${files})
  if(NOT "${file}" STREQUAL "")
    if(EXISTS "$ENV{DESTDIR}${file}" OR IS_SYMLINK "$ENV{DESTDIR}${file}")
      message(STATUS "Removing $ENV{DESTDIR}${file}")
      file(REMOVE "$ENV{DESTDIR}${file}")
    else()
      message(STATUS "Already gone: $ENV{DESTDIR}${file}")
    endif()
  endif()
endforeach()
